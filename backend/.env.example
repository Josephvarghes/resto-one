# RestoOne Configuration
DATABASE_URL=sqlite:///./resto.db
SECRET_KEY=restaurant-super-secret-jwt-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Groq AI Settings
# Enter your Groq API key below to enable live Groq LLM completions.
# If left blank or unset, the system automatically uses the built-in culinary concierge engine.
GROQ_API_KEY="sample"
GROQ_MODEL=openai/gpt-oss-120b
